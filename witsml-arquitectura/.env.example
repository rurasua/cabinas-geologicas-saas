# ─────────────────────────────────────────────────────────────────────
# .env.example — copiar a .env para desarrollo local con emulador
# NUNCA commitear .env (está en .gitignore)
# ─────────────────────────────────────────────────────────────────────

# Entorno
ENV=local
FIRESTORE_PROJECT=demo-cabinas-geologicas

# Polling
POLL_INTERVAL_MIN=5
POLL_TIMEOUT_SEC=25

# Detección
GAS_PEAK_THRESHOLD_PPM=8000
GAS_SUSTAINED_THRESHOLD_PPM=4000
GAS_SUSTAINED_MIN_SAMPLES=3
DENSITY_DROP_THRESHOLD=0.15
ROP_DROP_PCT=0.40
ROP_WINDOW_MIN=60

# Email (Gmail SMTP con App Password de 16 chars)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
ALERT_FROM_EMAIL=alertas@tu-dominio.com

# Twilio (sandbox: el destinatario debe unirse al sandbox primero)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Credenciales de cabinas de prueba
TEST_CABIN_URL=https://demo.empresa.com/witsml/store
TEST_CABIN_USER=svc_demo
TEST_CABIN_PASS=demo_pass
